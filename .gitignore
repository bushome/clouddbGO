# .gitignore for clouddbGo
#
# Place this at the root of C:\Dev\clouddbGo\ (a .git folder already exists
# there, so this is the last step before your first `git add`/`git commit`).

# Symlinked folders — real content lives in, and is already tracked by, the
# dev-tree repo (ark-cloud-storage-no-overflow). Never commit these here.
/src/
/prisma/
/scripts/

# Compiled/generated output — regenerated by `npm run build` /
# `npm run prisma:generate`.
/dist/
/generated/

# Dependencies
/node_modules/

# The actual SQLite database file(s) live here (e.g.
# data\cloudstorage.db, per the zero-config SQLite boot log). Real data,
# not source — never commit, regardless of whether this tree is still
# test-only or eventually holds real player/cluster data.
/data/

# watchdog/ is a real, manually-copied folder here (not symlinked — matches
# this project's established watchdog convention across every tree).
# watchdog.js itself is fine to track; watchdog-config.json is excluded
# because its appDir is an absolute, environment-specific path per
# CLAUDE.md's own documentation of that field.
/watchdog/watchdog-config.json

# Real, environment-specific config — not currently present in this tree
# (your zero-config SQLite testing ran without one at all), but excluded
# preemptively since a real config.json here would carry real
# ClusterId/Secret values once this stops being test-only. If/when you add
# one, consider also committing a config.json.example as a template, same
# as clouddb/clouddbSEA do.
/config.json
